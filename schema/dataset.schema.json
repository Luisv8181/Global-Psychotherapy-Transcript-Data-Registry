{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Psychotherapy Dataset Registry Record",
  "type": "object",
  "required": [
    "id",
    "title",
    "canonical_url",
    "status",
    "dataset_type"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Stable lowercase identifier; must match the record's file name."
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "canonical_url": {
      "type": "string",
      "format": "uri"
    },
    "status": {
      "enum": [
        "verified",
        "partially-verified",
        "unverified",
        "deprecated"
      ]
    },
    "dataset_type": {
      "enum": [
        "real",
        "synthetic",
        "hybrid",
        "unknown"
      ]
    },
    "source_context": {
      "type": [
        "string",
        "null"
      ]
    },
    "geography": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "countries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "regions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scope": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_level": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "language_context": {
      "type": [
        "string",
        "null"
      ]
    },
    "dialects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cultural_contexts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "therapy_modalities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sessions": {
      "description": "Published session count, or 'unknown' when the sources reviewed do not establish it.",
      "anyOf": [
        {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        {
          "const": "unknown"
        }
      ]
    },
    "longitudinal": {
      "description": "true only when repeated observations of the same participant or case are documented. Use 'unknown' rather than inferring.",
      "enum": [
        true,
        false,
        null,
        "unknown"
      ]
    },
    "access": {
      "type": "object",
      "properties": {
        "level": {
          "type": [
            "string",
            "null"
          ]
        },
        "requirements": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "privacy": {
      "type": "object"
    },
    "evidence": {
      "type": "object",
      "properties": {
        "primary_sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "supporting_publications": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "supporting_sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "last_verified": {
      "description": "ISO date (YYYY-MM-DD) of the last check against primary sources.",
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "collection_start_year": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1800
    },
    "collection_end_year": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1800
    },
    "publication_year": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1800
    },
    "release_year": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1800
    },
    "historical_period": {
      "type": [
        "string",
        "null"
      ]
    },
    "therapy_era": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "historical_significance": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "license": {
      "type": "object",
      "properties": {
        "type": {
          "type": [
            "string",
            "null"
          ]
        },
        "verified": {
          "type": "boolean"
        },
        "source": {
          "type": "string",
          "description": "URL of the page where the dataset's own license was read (repository LICENSE file, dataset card, data repository record). Not the article's license page."
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "redistribution": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
